# Copy this file to .env.development and fill in your own local values.
# Never commit .env.development or .env.production.
PORT=3000
NODE_ENV=development
DB_URI=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/its_db

# Use a random 32-byte key for AES-256-CBC.
ENC_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_KEY
IV_LENGTH=16
SALT=12

# Use unique, high-entropy secret values, not the examples below.
ACCESS_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_ACCESS_SECRET
ACCESS_USER_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_USER_ACCESS_SECRET
ACCESS_ADMIN_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_ADMIN_ACCESS_SECRET
REFRESH_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_REFRESH_SECRET
REFRESH_USER_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_USER_REFRESH_SECRET
REFRESH_ADMIN_TOKEN_SIGNATURE=REPLACE_WITH_RANDOM_ADMIN_REFRESH_SECRET

ACCESS_TOKEN_EXPIRES_IN=18000
REFRESH_TOKEN_EXPIRES_IN=31536000
WEB_CLIENT_ID=
